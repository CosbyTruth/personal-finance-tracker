{
  "expo": {
    "name": "Kora Money",
    "slug": "kora-money",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "koramoney",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.koramoney.app"
    },
    "android": {
      "package": "com.koramoney.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
