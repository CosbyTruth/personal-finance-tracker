{
  "name": "personal-finance-tracker",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server/server.js",
    "dev:client": "vite",
    "db:init": "node server/init-db.js",
    "db:migrate": "node server/migrate.js",
    "db:migrate:check": "node server/check-migrations.js",
    "db:check": "node server/check-db.js",
    "env:check": "node server/check-env.js",
    "test": "node --test",
    "check": "node --check server/app.js && node --check server/routes/auth.js && node --check server/routes/finance.js && node --check server/data/ledger-repository.js && node --check server/data/finance-read-repository.js && node --check server/auth-rate-limit.js && node --check server/migrate.js && npm test && npm run build",
    "build": "vite build --configLoader runner",
    "preview": "vite preview",
    "start": "node server/server.js",
    "deploy:check": "npm run env:check && npm run db:check && npm run db:migrate:check && npm run check"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "nodemon": "^3.1.10",
    "vite": "^7.1.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
